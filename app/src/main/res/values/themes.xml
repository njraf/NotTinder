<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NotTinder" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.NotTinder.Starting" parent="Theme.SplashScreen.IconBackground">
        <!-- Set the splash screen background, animated icon, and animation
        duration. -->
        <item name="windowSplashScreenBackground">@color/cyan</item>

        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated
             drawable. One of these is required. -->
        <!--<item name="windowSplashScreenAnimatedIcon">@drawable/snowflake</item>-->
        <!-- Required for animated icons. -->
        <!--<item name="windowSplashScreenAnimationDuration">1000</item>-->

        <!-- Set the theme of the Activity that directly follows your splash
        screen. This is required. -->
        <item name="postSplashScreenTheme">@style/Theme.NotTinder</item>
    </style>
</resources>